# 변수 이름만 공유한다. 실제 값은 루트 .env.local(커밋 금지)과 Vercel 대시보드에만 넣는다.

# --- 서버 전용 (프론트·VITE_ 변수에 넣지 않는다) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# true면 Gemini 대신 고정 관찰 JSON 반환 (평소 개발은 true)
MOCK_VISION=true
# 선택: 없으면 로깅을 건너뛴다
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 프론트 (비밀 아님) ---
# 기본 빈 값(같은 도메인). 백엔드를 Render 등으로 분리할 때만 사용
VITE_API_BASE=
